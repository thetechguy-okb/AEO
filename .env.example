# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL SERVICE (Server-side DCM Brief Request delivery to aeo@athenacentre.org)
# Preferred Option 1: Microsoft 365 via Microsoft Graph API (OAuth 2.0 client credentials + Exchange Online RBAC)
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_GRAPH_SENDER="aeo@athenacentre.org"
DCM_BRIEF_RECIPIENT="aeo@athenacentre.org"

# Fallback Option 2: Authenticated SMTP (e.g. Google Workspace, SendGrid, Postmark, Zoho)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Athena Election Observatory <aeo@athenacentre.org>"

# Fallback Option 3: Resend API
RESEND_API_KEY=""
